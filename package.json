{
  "name": "queueflow",
  "version": "1.0.0",
  "description": "QueueFlow - Full-Stack Queue Management Platform",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "test:backend": "cd backend && npm run test",
    "seed:backend": "cd backend && node seed.js",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1"
  },
  "keywords": [
    "queueflow",
    "queue-management",
    "fullstack",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Dhinesh Kandukuri",
  "license": "ISC"
}
